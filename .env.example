PORT=8000
FAL_KEY=
FAL_MODEL=fal-ai/nano-banana/edit

# These are intentionally generic until the final creative direction is supplied.
VARIANT_A_LABEL=Reimagined One
VARIANT_B_LABEL=Reimagined Two
VARIANT_A_PROMPT=Recreate the source photo with identical framing, crop, camera angle, body proportions, poses, facial expressions, and number of people. Keep every face recognizable. Transform only the environment, wardrobe, lighting, materials, and art direction according to the first experience concept.
VARIANT_B_PROMPT=Recreate the source photo with identical framing, crop, camera angle, body proportions, poses, facial expressions, and number of people. Keep every face recognizable. Transform only the environment, wardrobe, lighting, materials, and art direction according to the second experience concept.
TRANSITION_PROMPT=Transform the complete three-panel photo strip into an alternate version while keeping every panel in exactly the same size and position. Preserve the strip composition and make the change visually coherent.

# The strip is always saved. Printing is skipped unless a server URL is provided.
PRINT_SERVER_URL=
PRINT_GAMMA=1.15
ENABLE_ANIMATION=true

# Layout and artwork can be replaced without touching the pipeline.
STRIP_BACKGROUND=assets/strip-background.svg
STRIP_WIDTH=600
STRIP_HEIGHT=1800
PHOTO_WIDTH=540
PHOTO_HEIGHT=440
PHOTO_LEFT=30
PHOTO_TOP=60
PHOTO_GAP=60
UPLOAD_MAX_MB=15
