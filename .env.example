PORT=8000
FAL_KEY=
FAL_MODEL=fal-ai/flux-2-flex/edit

# Thesis: 2027 editorial portrait direction. Replace these whole values for a different event.
VARIANT_A_LABEL=Thesis Blue
VARIANT_B_LABEL=Thesis Coral
VARIANT_A_PROMPT=Recreate the SOURCE IMAGE as an Every / Thesis: 2027 editorial conference speaker portrait. CRITICAL COMPOSITION LOCK: keep the exact same framing, crop, camera angle, perspective, focal length, number of people, body proportions, poses, facial expressions, and recognizable faces. Do not add, remove, move, resize, or merge people. Render every person as a crisp, high-contrast black-and-white photographic cutout with a lightly posterized photocopy / screenprint texture, preserving facial detail and clothing silhouette. Replace only the background with a saturated electric blue field (#2B83EE) and one broad rough diagonal dry-brush swash behind the subject in a darker blue. Add subtle offset ink registration, coarse halftone dots, paper fiber, and imperfect risograph grain. Keep the result bold, art-directed, tactile, and editorial. Do not add any text, lettering, logo, watermark, border, icon, or object over a face.
VARIANT_B_PROMPT=Recreate the SOURCE IMAGE as an Every / Thesis: 2027 editorial conference speaker portrait. CRITICAL COMPOSITION LOCK: keep the exact same framing, crop, camera angle, perspective, focal length, number of people, body proportions, poses, facial expressions, and recognizable faces. Do not add, remove, move, resize, or merge people. Render every person as a crisp, high-contrast black-and-white photographic cutout with a lightly posterized photocopy / screenprint texture, preserving facial detail and clothing silhouette. Replace only the background with a warm coral field (#FF7B70) and one broad rough diagonal dry-brush swash behind the subject in a slightly darker coral. Add subtle offset ink registration, coarse halftone dots, paper fiber, and imperfect risograph grain. Keep the result bold, art-directed, tactile, and editorial. Do not add any text, lettering, logo, watermark, border, icon, or object over a face.
TRANSITION_PROMPT=Transform the complete three-panel photo strip into a lively Every / Thesis: 2027 editorial print collage while keeping every panel exactly the same size and position. Preserve the three-panel composition and all people. Use saturated electric blue, coral, cyan, and yellow color blocks, rough diagonal painterly swashes, black-and-white halftone photocopy texture, paper grain, and slightly misregistered risograph ink. Keep all faces recognizable and do not add any text, logos, or watermarks.

# Printing is intentionally disabled for this version. The kiosk displays a coming-soon message.
ENABLE_ANIMATION=true

# Layout and artwork can be replaced without touching the pipeline.
STRIP_BACKGROUND=assets/strip-background.svg
STRIP_WIDTH=600
STRIP_HEIGHT=1800
PHOTO_WIDTH=540
PHOTO_HEIGHT=440
PHOTO_LEFT=30
PHOTO_TOP=60
PHOTO_GAP=60
UPLOAD_MAX_MB=15
